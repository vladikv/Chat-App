# Copy to .env (never commit .env) and fill in real values

POSTGRES_DB=chatapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=vladik123

# 64+ hex characters, e.g. generate with: openssl rand -hex 32
APP_JWT_SECRET=198a200cf269ac0717e5e89499ccb95dde440a0258a31c7426f564394adbc50a

# Optional overrides (milliseconds)
# APP_JWT_EXPIRATION=900000
# APP_JWT_REFRESH_EXPIRATION=604800000

# Host ports (left side of the mapping). Change one if it is already in use.
# The containers still talk to each other on the standard internal ports.
APP_PORT=8082
DB_PORT=5433
REDIS_PORT=6379
